        "func": "const b = msg.payload || {};\nconst n = Number(b.batas);\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\nif (b.batas === undefined || b.batas === null || b.batas === '' || !isFinite(n) || n < -40 || n > 125) {\n    msg.statusCode = 400;\n    msg.payload = {status: 'error', message: 'batas wajib berupa angka antara -40 dan 125'};\n    return [msg, null];\n}\nflow.set('threshold', n);\nflow.set('alertActive', false);   // evaluasi ulang dengan batas baru\nmsg.statusCode = 200;\nmsg.payload = {status: 'success', message: 'Batas suhu diperbarui', batas: n};\nreturn [msg, {payload: {type: 'threshold', batas: n}}];",
