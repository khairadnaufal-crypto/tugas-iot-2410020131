    {
        "id": "7cae7eaa4590876c",
        "type": "function",
        "z": "a8f94ddf15d59a9d",
        "name": "Proses data sensor",
        "func": "// Terima data MQTT -> simpan ke DB, siarkan via WebSocket, cek batas suhu\nconst d = msg.payload;\nif (typeof d !== 'object' || d === null || typeof d.suhu !== 'number') return null;\n\nd.received = new Date().toISOString();\nflow.set('lastSensor', d);\n\nconst batas = flow.get('threshold');\nconst kelembaban = (typeof d.kelembaban === 'number') ? d.kelembaban : null;\n\n// Output 1: simpan ke SQLite (prepared statement)\nconst dbMsg = {params: {$suhu: d.suhu, $kelembaban: kelembaban, $received: d.received}};\n// Output 2: siaran WebSocket\nconst wsMsg = {payload: {type: 'sensor', data: d, threshold: batas}};\n// Output 3: notifikasi (hanya saat status berubah, supaya tidak spam)\nlet alertMsg = null;\nconst over = d.suhu > batas;\nconst aktif = flow.get('alertActive');\nif (over && !aktif) {\n    flow.set('alertActive', true);\n    alertMsg = {topic: 'iot/notifikasi', payload: {\n        type: 'alert',\n        message: 'Suhu ' + d.suhu + '°C melewati batas ' + batas + '°C',\n        suhu: d.suhu, batas: batas, waktu: d.received}};\n} else if (!over && aktif) {\n    flow.set('alertActive', false);\n    alertMsg = {topic: 'iot/notifikasi', payload: {\n        type: 'alert_clear',\n        message: 'Suhu kembali normal: ' + d.suhu + '°C (batas ' + batas + '°C)',\n        suhu: d.suhu, batas: batas, waktu: d.received}};\n}\nreturn [dbMsg, wsMsg, alertMsg];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
