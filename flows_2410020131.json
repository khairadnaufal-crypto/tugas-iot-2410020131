    {
        "id": "store_sensor",
        "type": "function",
        "z": "flow_api",
        "name": "Simpan Data Sensor",
        "func": "var data = msg.payload;\ndata.received = new Date().toISOString();\nflow.set('lastSensor', data);\n\nvar history = flow.get('history') || [];\nhistory.push(data);\nif (history.length > 50) history.shift();\nflow.set('history', history);\n\nreturn msg;",
        "outputs": 1,
        "x": 410,
        "y": 100,
        "wires": [
            [
                "debug_sensor"
            ]
        ]
    },
