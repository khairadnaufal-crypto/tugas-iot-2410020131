    {
        "id": "464a79b2d33cb1ec",
        "type": "function",
        "z": "a8f94ddf15d59a9d",
        "name": "Autentikasi WS",
        "func": "// Klien WebSocket harus kirim {\"type\":\"auth\",\"key\":\"...\"} setelah terhubung\nlet m = msg.payload;\nif (typeof m === 'string') {\n    try { m = JSON.parse(m); } catch (e) { m = {}; }\n}\nif (!m || m.type !== 'auth') return null;\n\nconst ok = !!m.key && m.key === flow.get('apiKey');\nconst clients = flow.get('wsClients') || {};\nconst id = msg._session.id;\nif (ok) {\n    clients[id] = Date.now();\n    const ids = Object.keys(clients);\n    if (ids.length > 50) {            // batasi daftar klien (sesi lama tidak ada event disconnect)\n        ids.sort((a, b) => clients[a] - clients[b]);\n        delete clients[ids[0]];\n    }\n} else {\n    delete clients[id];\n}\nflow.set('wsClients', clients);\nmsg.payload = {type: 'auth', ok: ok};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
