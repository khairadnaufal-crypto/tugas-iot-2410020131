        "name": "Siarkan ke klien WS",
        "func": "// Kirim ke semua klien WebSocket yang sudah lolos autentikasi\nconst clients = flow.get('wsClients') || {};\nconst out = Object.keys(clients).map(id => ({\n    payload: msg.payload,\n    _session: {type: 'websocket', id: id}\n}));\nreturn [out];",
