        "name": "Validasi & publish",
        "func": "const body = msg.payload || {};\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\nif (!body.device || !body.action) {\n    msg.statusCode = 400;\n    msg.payload = {status: 'error', message: 'device dan action wajib diisi'};\n    return [msg, null];\n}\nif (!['on', 'off'].includes(String(body.action).toLowerCase())) {\n    msg.statusCode = 400;\n    msg.payload = {status: 'error', message: \"action harus 'on' atau 'off'\"};\n    return [msg, null];\n}\nconst mqttMsg = {topic: 'iot/kontrol', payload: body};\nmsg.statusCode = 200;\nmsg.payload = {status: 'success', message: 'Perintah terkirim', sent: body};\nreturn [msg, mqttMsg];",
